# 릴스핀 API 키 (선택) — 이 파일을 .env 로 복사해서 값을 채우세요.
# app.json 에는 절대 넣지 마세요. EXPO_PUBLIC_ 접두사만 앱 번들에 노출됩니다.

# 유튜브 쇼츠 제목·설명 (Data API v3, 무료 1만 유닛/일)
EXPO_PUBLIC_YOUTUBE_API_KEY=

# 캡션 → 장소 JSON 추출 (gpt-4o-mini)
EXPO_PUBLIC_OPENAI_API_KEY=

# 네이버 지역검색 (좌표·도로명주소)
EXPO_PUBLIC_NAVER_SEARCH_KEY_ID=
EXPO_PUBLIC_NAVER_SEARCH_SECRET=
