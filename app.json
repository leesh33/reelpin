{
  "expo": {
    "name": "릴스핀",
    "slug": "reelpin",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reelpin",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.odol.reelpin",
      "buildNumber": "5",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "저장한 맛집 근처에 도착했을 때 알려드리기 위해 위치를 사용합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "앱이 꺼져 있어도 저장한 맛집 근처에서 알려드리기 위해 위치를 사용합니다."
      }
    },
    "android": {
      "package": "com.odol.reelpin",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    }
  }
}
