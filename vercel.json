{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx expo export --platform web && node scripts/patch-web-html.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/gemini.js": {
      "maxDuration": 30
    },
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/)(?!_expo/)(?!assets/)(?!favicon\\.ico)(?!metadata\\.json)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
